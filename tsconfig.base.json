{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@corp/design-system/tokens": [
        "./libs/design-system/tokens/src/index.ts"
      ],
      "@corp/design-system/ui": ["./libs/design-system/ui/src/index.ts"],
      "@corp/features/auth": ["./libs/features/auth/src/index.ts"],
      "@corp/data-access/api": ["./libs/data-access/api/src/index.ts"],
      "@corp/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "@corp/shared/models": ["./libs/shared/models/src/index.ts"],
      "@corp/ui/shared": ["./libs/ui/shared/src/index.ts"],
      "@corp-workspace/inventory": ["./libs/features/inventory/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
